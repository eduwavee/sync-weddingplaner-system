# Copiá este archivo a .env y completá los valores. .env nunca se commitea.

DATABASE_URL=postgres://alianza:alianza@localhost:5432/alianza
# En Railway / Render / Neon la conexión va por SSL:
# PGSSL=require

# Clave para firmar los tokens de sesión. Generá una así:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Desde dónde se puede llamar a la API. Vacío = cualquier origen (sólo para desarrollo).
# CORS_ORIGIN=https://alianza.syncsolutions.com.ar

PORT=3000

# Datos de ejemplo que carga `npm run seed`
SEED_PLANNER_EMAIL=planner@alianza.test
SEED_PLANNER_PASSWORD=
